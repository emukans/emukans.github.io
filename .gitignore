# Bundler cache
.bundle
vendor
Gemfile.lock

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# IDE configurations
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Misc
_sass/vendors
assets/js/dist

# Style guide: only the two files the site loads are published
# (see _includes/metadata-hook.html); the guide, templates and render script stay local
styleguide/*
!styleguide/tokens.css
!styleguide/components.css

# Python (styleguide/render.py)
__pycache__/
.venv/
venv/

# Local tooling and notes, not used by the site
.claude/
CLAUDE.md
blog-update-tasks.md

# Hidden system files
*~
.DS_Store
Thumbs.db
